<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style.css">
    <title>URL Shortener</title>
</head>
<body>
    <main>
        <h1>URL Shortener</h1>
        <form action="/" method="post">
            <div>
                <label for="url">URL:</label>
                <input type="url" name="url" id="url" placeholder="www.google.com">
            </div>
            <div>
                <label for="shortCode">Short:</label>
                <input type="text" name="shortCode" id="shortCode" placeholder="Google">
            </div>
            <button type="submit">Submit</button>
        </form>

        <h2>Links</h2>
        <ul>
            <% Object.entries(links).forEach(([shortCode, url]) => { %>
                <li>
                    <a href="/<%= shortCode %>" target="_blank"><%= shortCode %></a>
                </li>
            <% }) %>
        </ul>
    </main>
</body>
</html>