<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products</title>
</head>
<body>
    <ul>
        <% products.forEach(pro => { %>
            <li>
                <p>Name: <%= pro.name %></p>
                <p>Category <%= pro.category %></p>
                <% if(pro.stock){ %>
                    <span style="color: red;">Out of Stock</span>
                <% } %>
            </li>
        <% }) %>
        </ul>
</body>
</html>