<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profile</title>
  </head>
  <body>
    <h1>Name: <%= user.username %></h1>
    <% if(user.isPremium) { %>   
        <p>Badge: Premium Member</p> 
        <% } else{ %>
            <p>Badge: Free Tier</p>
            <% } %>
            <ul>
            <% user.skills.forEach(skill => { %>
                <li><%= skill %></li>
                <% })%>
                </ul>
  </body>
</html>
