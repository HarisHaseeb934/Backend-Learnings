<%- include('../partials/header') %>

<main class="changePass">
  <h1>Reset Your Password</h1>
  <form action="/reset-password/<%= token %>" method="post">
    <input type="text" name="newPassword" placeholder="Enter Your New Password"/>
    <div>
        <p>Password must</p>
      <ul>
        <li>Be at least 8 charaacter long</li>
        <li>Contain a number</li>
        <li>Include upper case and lower case letters</li>
      </ul>
    </div>
    <input type="text" name="confirmPassword" placeholder="Confirm Your New Password"/>

    <% if(errors && errors.length > 0){ %>
    <% errors.forEach(error => {error[1].forEach(e => { %>
      <p class="error"><%= e %></p>
    <% } )})} %>

    <% if(singleError.length > 0){ %>
      <p class="error"><%= singleError %></p>
    <% } %>

    <button type="submit">
        Change Password
    </button>
  </form>
</main>

<%- include('../partials/footer') %>
