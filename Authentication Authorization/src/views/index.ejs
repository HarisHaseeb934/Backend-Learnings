<%- include('./partials/header') %>

<main class="url">
        <h1>URL Shortener</h1>
        <form action="/form" method="post" class="url-short">
            <div>
                <label for="url">URL:</label>
                <input type="url" name="url" id="url">
            </div>
            <div>
                <label for="shortCode">Short Code:</label>
                <input type="text" name="shortCode" id="shortCode">
            </div>
            <button type="submit">Submit</button>
        </form>
        <h2>Links</h2>
        <ul>
            <% links.map(({shortCode, url, id}) => { %>
                <li class="li"><a href='/<%= shortCode %>' target="_blank"><%= host %>/<%= shortCode %></a> <a href="/edit/<%= id %>">Edit</a> <form action="/delete/<%= id %>" method="post"><button type="submit">Delete</button></form></li>
            <% }) %>
        </ul>
    </main>

<%- include('./partials/footer') %>