<%- include('./partials/header') %>

<main class="url">
        <h1>URL Shortener</h1>
        <form action="/form" method="post" class="url-short">
            <div>
                <label for="url">URL:</label>
                <input type="url" name="url" id="url">
            </div>
            <div>
                <label for="shortCode">Short Code:</label>
                <input type="text" name="shortCode" id="shortCode">
            </div>
            <button type="submit">Submit</button>
        </form>
        <h2>Links</h2>
        <ul>
            <% links.map(({shortCode, url, id}) => { %>
                <li class="li"><a href='/<%= shortCode %>' target="_blank"><%= host %>/<%= shortCode %></a> <a href="/edit/<%= id %>">Edit</a> <form action="/delete/<%= id %>" method="post"><button type="submit">Delete</button></form></li>
            <% }) %>
        </ul>
    </main>
    <div class="pagination">
        <%
            let startPage = Math.max(1, currentPage - 2);
            let endPage = Math.min(totalPages, currentPage + 2);
        %>

        <% if(totalPages > 1){ %>
            <% if(currentPage > 1){ %>
                <a href = '?page=<%= currentPage - 1 %>'>Prev</a>
            <% }else{ %>
                <a disabled>Prev</a>
            <% } %>

            <% if(startPage > 1){ %>
                <a href = '?page=<%= 1 %>'>1</a>
                <% if(startPage - 1 > 1){ %>
                <span>...</span>
                <% } %>
            <% } %>

            <% for(let i = startPage; i <= endPage; i++){ %>
                <a href="?page=<%= i %>"><%= i %></a>
            <% } %>
            
            <% if(endPage < totalPages){ %>
                <% if(endPage < totalPages - 1){ %>
                <span>...</span>
                <% } %>
                <a href = '?page=<%= totalPages %>'><%= totalPages %></a>
            <% } %>

            <% if(currentPage < totalPages){ %>
                <a href = '?page=<%= currentPage + 1 %>'>Next</a>
            <% }else{ %>
                <a disabled>Next</a>
            <% } %>
        <% } %>
    </div>


<%- include('./partials/footer') %>